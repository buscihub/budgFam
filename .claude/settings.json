{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:rls)",
      "Bash(pnpm test:rls *)",
      "Bash(pnpm install)",
      "Bash(pnpm exec *)",
      "Bash(node scripts/check-task-docs.mjs)",
      "Bash(node scripts/check-task-docs.mjs *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge-base *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run *)",
      "Bash(supabase start)",
      "Bash(supabase status)",
      "Bash(supabase db reset)",
      "Bash(supabase migration new *)",
      "Bash(supabase gen types *)",
      "Bash(python3 -m venv /tmp/pdfgen-venv)",
      "Bash(/tmp/pdfgen-venv/bin/pip install reportlab)",
      "Bash(/tmp/pdfgen-venv/bin/python3 study/build_pdf.py)"
    ],
    "ask": ["Edit(/supabase/migrations/**)"],
    "deny": [
      "Read(/.env.local)",
      "Read(/.env.*.local)",
      "Bash(supabase db push)",
      "Bash(supabase db push *)",
      "Bash(supabase link)",
      "Bash(supabase link *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/check-task-docs.mjs --hook"
          }
        ]
      }
    ]
  }
}
